# Copy into your process environment; Go does not auto-load dotenv files.
APP_ENV=development
DATABASE_URL=postgres://guestbook_runtime:CHANGE_ME@127.0.0.1:5432/guestbook?sslmode=disable
LISTEN_ADDR=127.0.0.1:3030
STATIC_DIR=../dev/dist
# Production network connections require sslmode=verify-full and sslrootcert.
# DATABASE_URL=postgres://guestbook_runtime:CHANGE_ME@db.example.invalid:5432/guestbook?sslmode=verify-full&sslrootcert=/etc/obedman/db-ca.pem
# Only when cloudflared connects directly over loopback:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

[Unit]
Description=Obedman portfolio and guestbook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obedman
Group=obedman
WorkingDirectory=/opt/obedman/current
EnvironmentFile=/etc/obedman/runtime.env
ExecStart=/opt/obedman/current/obedman-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
